{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "pnpm-specific configuration",
  "extends": [
    "local>happyvertical/renovate-config"
  ],
  "lockFileMaintenance": {
    "enabled": false
  },
  "postUpdateOptions": ["pnpmDedupe"],
  "allowedPostUpgradeCommands": ["^pnpm"],
  "postUpgradeTasks": {
    "commands": ["pnpm install --no-frozen-lockfile"],
    "fileFilters": ["pnpm-lock.yaml"],
    "executionMode": "branch"
  },
  "packageRules": [
    {
      "description": "Bump ranges, except org-standard tools which stay pinned (see org-standards.json)",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "!typescript",
        "!vitest",
        "!@vitest/**",
        "!vite",
        "!@sveltejs/kit",
        "!@biomejs/biome",
        "!turbo",
        "!lefthook"
      ],
      "rangeStrategy": "bump"
    }
  ]
}
